{
    "packages": [
        "packages/plasma-ui",
        "packages/plasma-core",
        "packages/plasma-typo",
        "packages/plasma-colors",
        "packages/plasma-tokens",
        "utils/plasma-tokens-utils",
        "utils/plasma-cy-utils",
        "utils/plasma-sb-utils",
        "utils/plasma-docs-ui",
        "website/plasma-ui-docs"
    ],
    "version": "independent",
    "useWorkspaces": true,
    "ignoreChanges": ["*.md", "*.component-test.tsx", "package-lock.json"],
    "loglevel": "verbose",
    "exact": true,
    "command": {
        "bootstrap": {
            "npmClientArgs": ["--no-audit", "--loglevel error", "--no-progress", "--unsafe-perm"]
        },
        "publish": {
            "verifyAccess": false,
            "private": false
        },
        "version": {
            "private": false
        },
        "list": {
            "ignoreChanges": ["*.md", "package-lock.json"]
        }
    },
    "$schema": "node_modules/lerna/schemas/lerna-schema.json"
}
